# 未设置 DATABASE_URL 时使用内嵌 PGlite（Postgres WASM），数据落盘 server/.data/pglite
DATABASE_URL=postgresql://postgres:password@localhost:5432/gut_garden

JWT_SECRET=change-me-in-production
# access token 有效期，默认 7d
# ACCESS_TOKEN_TTL=7d

# 管理员手机号（逗号分隔），登录后 JWT 带 role=admin，可调用 /api/admin/* 接口
# ADMIN_PHONES=13800008888,13800009999

# 服务端口，默认 3001
# PORT=3001

# AI 对话（菌小园）：默认接 Qwen Flash（DashScope compatible-mode，OpenAI 兼容协议）
# 通过环境变量注入（systemd/Docker/启动命令 export，或在此文件填入均可，系统环境变量优先）
# 1. 到 https://dashscope.console.aliyun.com/ 创建 API Key
# 2. 设置 AI_API_KEY=你的真实Key 后重启 server
# 3. 设置了 AI_API_KEY 才走大模型流式；未设置 / 上游失败时自动降级为 FAQ 关键词回答
AI_API_KEY=sk-xxx
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen-flash

# 便便拍照分析：设置了 STOOL_API_KEY 走外部 API；未设置时默认 STOOL_MOCK=true 用本地规则
STOOL_API_KEY=xxx
# STOOL_API_URL=
# STOOL_MOCK=true
